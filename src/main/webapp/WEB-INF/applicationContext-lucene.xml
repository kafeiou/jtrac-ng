<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">
    
    <bean id="indexDirectory" class="info.jtrac.lucene.LuceneDirectoryFactoryBean">
        <property name="path" value="${jtrac.home}/indexes"/>
    </bean>
    
    <bean id="analyzer" class="info.jtrac.lucene.JtracAnalyzer"/>

    <bean id="indexer" class="info.jtrac.lucene.Indexer">
        <property name="indexDirectory" ref="indexDirectory"/>
        <property name="analyzer" ref="analyzer"/>
    </bean>
    
    <bean id="searchExpander" class="info.jtrac.lucene.OllamaSearchExpander"/>

    <bean id="indexSearcher" class="info.jtrac.lucene.IndexSearcher">
        <property name="indexDirectory" ref="indexDirectory"/>
        <property name="analyzer" ref="analyzer"/>
        <property name="searchExpander" ref="searchExpander"/>
    </bean>
           
</beans>
